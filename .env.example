# Sao chép file này thành .env rồi điền giá trị THẬT của Supabase.
# .env không được commit lên GitHub (đã có trong .gitignore) — mỗi máy tự tạo
# file .env riêng, không dùng chung. Xem README mục "Getting Started".

# Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Settings → API → Project API keys → khoá "anon public" (hoặc
# "publishable key" ở giao diện Supabase mới). TUYỆT ĐỐI không dùng
# service_role key ở đây — đó là khoá quyền admin, không được đưa vào app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Giả lập thiết bị BLE khi chưa có phần cứng thật (1 = bật, để trống hoặc bỏ dòng = tắt)
EXPO_PUBLIC_MOCK_BLE=1
